NODE_ENV=development
HOST=127.0.0.1
PORT=17500
DATABASE_PATH=data/workbench.sqlite
SESSION_COOKIE_NAME=workbench_session
UPLOADS_DIR=data/uploads/reports

# ---------------------------------------------------------------- WebDAV
# WebDAV 的**地址**是部署级的：一个团队通常共用同一个 NAS，所以放在这里，
# 不用每个人在网页里各填一遍。改完要重启服务才生效。
#
# 每个账号自己的**用户名 / 密码 / 浏览根目录 / 超时**仍然在网页里维护：
# 登录后进「设置 → WebDAV」，保存后按账号存进数据库（webdav_settings），即时生效。
#
# 只配了地址还不会自动对所有人开放：每个人都要在设置页里保存一次自己的账号
# （NAS 允许匿名访问就留空保存）。没保存过的账号，「重要文件」页只看本机路径索引。
#
# 地址不要内嵌账号密码；能用 https 就用 https——Basic 认证在明文 http 下等同于明文传输。
WEBDAV_URL=http://192.168.0.242:5005

# .env 会被服务自动加载（npm run serve / npm run dev / 各 CLI），
# 且**已经存在的进程环境变量优先**：`$env:PORT=18000; npm run serve` 仍然能临时覆盖。
# 这个文件里放的是本机私密配置，已被 .gitignore 忽略，不要提交。
