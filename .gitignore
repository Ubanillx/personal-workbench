# 依赖与构建产物
node_modules/
# 只忽略**根目录**的构建产物：无斜杠的 `build/` 会连源码目录 `tools/build/` 一起忽略，
# 而 `npm run build` 的第一步（tools/build/prebuild.ts）就在那里 —— 那会导致新克隆
# 与 CI 构建直接失败
/build/
.react-router/
*.tsbuildinfo
coverage/

# CI 打包中间产物与发布包（在 Jenkins 工作区里生成，不入库）
.release/
/dist/

# 运行时数据（含隐私：任务正文、上传的周报文件、数据库备份）
/data/

# 归档的旧 Electron 数据：旧 workbench.json 内含明文令牌，只保留在本机磁盘，不纳入版本控制
_archive/legacy-electron/data/

# 环境变量与日志
.env
.env.local
.env.*.local
*.log

# 编辑器与系统文件
.zed/
.DS_Store
Thumbs.db
desktop.ini
