{
  "name": "personal-workbench",
  "version": "1.0.0",
  "description": "个人工作台 - 任务进展 / 待办 / 随手记 / 企微任务收件箱（本地 Web 服务）",
  "author": "me",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "npm run build && set \"NODE_ENV=production\" && \"%npm_node_execpath%\" dist-server/server/src/index.js",
    "start:lan": "npm run build && set \"NODE_ENV=production\" && set \"HOST=0.0.0.0\" && set \"PORT=17500\" && \"%npm_node_execpath%\" dist-server/server/src/index.js",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "\"%npm_node_execpath%\" --watch --import tsx server/src/index.ts",
    "dev:web": "\"%npm_node_execpath%\" node_modules/vite/bin/vite.js --config web/vite.config.mts",
    "build:web": "\"%npm_node_execpath%\" node_modules/vite/bin/vite.js build --config web/vite.config.mts",
    "build:server": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p server/tsconfig.json",
    "build": "npm run build:web && npm run build:server",
    "typecheck": "npm run typecheck:server && npm run typecheck:web && npm run typecheck:tools && npm run typecheck:app",
    "typecheck:server": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p server/tsconfig.json --noEmit",
    "typecheck:web": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p web/tsconfig.json --noEmit",
    "typecheck:tools": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p tools/tsconfig.json",
    "typecheck:app": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "rr:dev": "react-router dev",
    "rr:build": "react-router build",
    "rr:start": "react-router-serve build/server/index.js",
    "contract:capture": "\"%npm_node_execpath%\" --import tsx tools/contract/capture.ts",
    "contract:compare": "\"%npm_node_execpath%\" --import tsx tools/contract/compare.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:api && npm run test:web && npm run test:db",
    "test:api": "\"%npm_node_execpath%\" --import tsx --test test/integration/workbench-workflow.test.ts test/integration/report-workflow.test.ts",
    "test:web": "\"%npm_node_execpath%\" --import tsx --test test/web/foundation.test.ts",
    "test:db": "\"%npm_node_execpath%\" --import tsx --test test/db/backup.test.ts test/db/json-migration.test.ts test/db/migration-backup.test.ts test/db/owner-token.test.ts",
    "owner:reset": "\"%npm_node_execpath%\" --import tsx server/src/cli/reset-owner-token.ts",
    "db:backup": "\"%npm_node_execpath%\" --import tsx server/src/cli/backup-sqlite.ts"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.3",
    "@react-router/dev": "^8.3.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "antd": "^6.6.3",
    "dayjs": "^1.11.23",
    "fastify": "^5.12.1",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  }
}
