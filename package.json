{
  "name": "personal-workbench",
  "version": "1.0.0",
  "description": "个人工作台 - 任务进展 / 待办 / 随手记 / 企微任务收件箱（本地 Web 服务）",
  "author": "me",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "npm run build && set \"NODE_ENV=production\" && set \"HOST=127.0.0.1\" && set \"PORT=17500\" && npm run serve",
    "start:lan": "npm run build && set \"NODE_ENV=production\" && set \"HOST=0.0.0.0\" && set \"PORT=17500\" && npm run serve",
    "serve": "react-router-serve build/server/index.js",
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "npm run typecheck:server && npm run typecheck:tools && npm run typecheck:app && npm run typecheck:test",
    "typecheck:server": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p server/tsconfig.json --noEmit",
    "typecheck:tools": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p tools/tsconfig.json",
    "typecheck:app": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "typecheck:test": "\"%npm_node_execpath%\" node_modules/typescript/lib/tsc.js -p test/tsconfig.test.json",
    "contract:capture": "\"%npm_node_execpath%\" --import tsx tools/contract/capture.ts",
    "contract:compare": "\"%npm_node_execpath%\" --import tsx tools/contract/compare.ts",
    "contract:fixture": "\"%npm_node_execpath%\" --import tsx tools/contract/make-fixture.ts",
    "smoke:ui": "\"%npm_node_execpath%\" --import tsx tools/contract/smoke-ui.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:db && npm run test:api && npm run test:owner && npm run test:ui",
    "test:api": "\"%npm_node_execpath%\" --import tsx tools/contract/compare.ts --serve-npm serve",
    "test:owner": "\"%npm_node_execpath%\" --import tsx --test test/api/owner-reset.test.ts",
    "test:ui": "\"%npm_node_execpath%\" --import tsx tools/contract/smoke-ui.ts --require-migrated",
    "test:db": "\"%npm_node_execpath%\" --import tsx --test test/db/backup.test.ts test/db/json-migration.test.ts test/db/migration-backup.test.ts test/db/owner-token.test.ts",
    "owner:reset": "\"%npm_node_execpath%\" --import tsx server/src/cli/reset-owner-token.ts",
    "db:backup": "\"%npm_node_execpath%\" --import tsx server/src/cli/backup-sqlite.ts"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.3",
    "@react-router/dev": "^8.3.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "antd": "^6.6.3",
    "dayjs": "^1.11.23",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  }
}
