# personal-workbench 目标服务器生产配置（模板）
#
# 由 `deploy.sh init` 首次渲染到 <ROOT>/shared/.env，之后**永不被自动覆盖**：
# 这是人工维护的状态，Jenkins 每次部署都不会碰它。
#
# 生效方式：值在进程启动时读取，改完必须重启：
#   sudo systemctl restart personal-workbench
# 注意：systemd 单元用 `node --env-file-if-exists` 读这个文件，所以值里不要写引号、
# 不要写行内注释（`KEY=value  # 注释` 会把注释一起当成值），注释请单独占一行。

# 必须是 production：跑 development 会改变错误处理与数据库连接失败时的行为。
NODE_ENV=production

# 监听地址。0.0.0.0 = 局域网可直接访问（与项目现有的 start:lan 一致，需自行确保防火墙只放行可信网段）；
# 若前面挂了 nginx / 反向代理，改成 127.0.0.1 更安全。
HOST=0.0.0.0
PORT=17500

# 数据一律落在 shared/ 下：release 目录每次部署都会被整体替换，数据放进去就会丢。
DATABASE_PATH=@ROOT@/shared/data/workbench.sqlite
UPLOADS_DIR=@ROOT@/shared/data/uploads/reports

SESSION_COOKIE_NAME=workbench_session

# WebDAV 只配地址（部署级、全员共用）；每个账号自己的用户名/密码/浏览根目录在网页
# 「设置 → WebDAV」里维护、存数据库、即时生效。留空 = 不接入远端。
# 周报正文共用管理员保存的那份连接（D-52），上传根目录**按组织**配置（D-53）：
# 组织管理者在同一个 Tab 里挑本组织的目录，默认用那份连接的浏览根目录。
# 不要在这里内嵌账号密码；能用 https 就用 https（Basic 认证在明文 http 下等于明文传密码）。
WEBDAV_URL=

# 管理员（admin）的**初始**密码：服务启动、自举数据库时读一次。
#   - 只在 admin 还没有密码（password_hash 是 locked$ 占位）时生效一次；
#     之后无论怎么改这个值都不会覆盖已设密码（改密码用本机 CLI `npm run user:passwd`）。
#   - 留空 = 保持原流程：必须在本机跑 `npm run user:init -- --confirm` 拿随机初始密码。
#   - 至少 8 位；不要加引号，不要写行尾注释（会被当成密码的一部分）。
#   - 密码会以明文留在这个文件里（权限 0640 root:workbench）。要更严就留空、改用 CLI。
WORKBENCH_ADMIN_PASSWORD=
